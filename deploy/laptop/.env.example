# Copy to .env. Never commit the real .env or share its contents in chat.
# Start with latest for initial setup; updater will pin a tested main commit SHA.
USD_IMAGE_TAG=latest

APP_DOMAIN=app.usd-russia.ru
API_DOMAIN=api.usd-russia.ru

POSTGRES_DB=usd
POSTGRES_USER=usd_app
# Use a long unique alphanumeric password; keep it identical in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql://usd_app:REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD@db:5432/usd?schema=public

# Generate a unique value locally with PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
JWT_ISSUER=usd-2.0-api
JWT_AUDIENCE=usd-2.0-client

# Local MinIO credentials. Generate a unique password locally; these credentials are only for this laptop.
# The same values initialize the local MinIO server and the API. Do not reuse cloud/production keys.
S3_BUCKET=usd-test
S3_ACCESS_KEY_ID=usdlocaladmin
S3_SECRET_ACCESS_KEY=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD

# Create a dedicated Cloudflare Tunnel. Keep token secret.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN
