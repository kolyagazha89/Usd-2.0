# Copy to .env on the Timeweb server. Never commit the real .env.
APP_DOMAIN=app.usd-russia.ru
API_DOMAIN=api.usd-russia.ru
ACME_EMAIL=admin@usd-russia.ru

# Use a long, unique alphanumeric password so DATABASE_URL does not need URL escaping.
POSTGRES_DB=usd
POSTGRES_USER=usd_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql://usd_app:REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD@db:5432/usd?schema=public

# Generate a unique secret, e.g. openssl rand -hex 32. Do not reuse a development secret.
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
JWT_ISSUER=usd-2.0-api
JWT_AUDIENCE=usd-2.0-client

# Production requires an S3-compatible object store for photos and site media.
# Fill these from the chosen provider (Timeweb Object Storage or another S3-compatible service).
S3_ENDPOINT=https://REPLACE_WITH_S3_ENDPOINT
S3_BUCKET=REPLACE_WITH_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
