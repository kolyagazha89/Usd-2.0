# Copy to .env locally. Never commit actual secrets.
APP_DOMAIN=app.usd-russia.ru
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
JWT_ISSUER=usd-2.0-api
JWT_AUDIENCE=usd-2.0-client
TUNNEL_TOKEN=REPLACE_WITH_NAMED_TUNNEL_TOKEN
# Keep current media storage until a separately reviewed migration.
S3_ENDPOINT=https://REPLACE_WITH_EXISTING_S3_ENDPOINT
S3_BUCKET=REPLACE_WITH_EXISTING_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
S3_REGION=auto
# Add the existing email provider configuration separately.
