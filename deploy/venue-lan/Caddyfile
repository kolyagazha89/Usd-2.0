# Router-only venue network; no dependency on public DNS or ACME.
https://{$VENUE_BIND_IP} {
  tls internal
  encode zstd gzip
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    # Defense in depth: even a missing/blocked venue bootstrap cannot call
    # the public API from the laptop. LAN browser requests stay same-origin.
    Content-Security-Policy "connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
  }
  handle_path /venue-api/* {
    reverse_proxy api:3000
  }
  handle {
    reverse_proxy frontend:80
  }
}
