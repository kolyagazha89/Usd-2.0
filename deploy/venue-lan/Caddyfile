# Router-only venue network; no dependency on public DNS or ACME.
# Windows Schannel may omit SNI for an IP address.
{
  default_sni {$VENUE_BIND_IP}
}
https://{$VENUE_BIND_IP} {
  tls internal
  encode zstd gzip
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    # Defense in depth: even a missing/blocked venue bootstrap cannot call
    # the public API from the laptop. LAN browser requests stay same-origin.
    Content-Security-Policy "connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
  }
  handle_path /venue-api/* {
    reverse_proxy api:3000 {
      # Browser sees /venue-api/auth, while Nest sets Path=/auth.
      header_down Set-Cookie "(?i)Path=/auth(;|$)" "Path=/venue-api/auth$1"
    }
  }
  handle {
    reverse_proxy frontend:80
  }
}

# Spectator-only TV on the same private Wi-Fi. No certificates to install on
# televisions. NEVER proxy login, administration, registrations or writes here.
# Authenticated judging remains exclusively on the HTTPS listener above.
http://{$VENUE_BIND_IP} {
  encode zstd gzip
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Cache-Control "no-store"
    Content-Security-Policy "default-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  }
  @venueTvEntry path / /venue/live/
  handle @venueTvEntry {
    redir * /venue/live?{http.request.uri.query} 307
  }
  handle /venue/live {
    reverse_proxy frontend:80
  }
  handle /usd-venue-config.js {
    reverse_proxy frontend:80
  }
  handle /assets/* {
    reverse_proxy frontend:80
  }
  @venueTvRead {
    path /venue-api/results/venue-live
    method GET
  }
  handle @venueTvRead {
    uri strip_prefix /venue-api
    reverse_proxy api:3000 {
      header_up -Cookie
      header_up -Authorization
    }
  }
  handle {
    respond "HTTPS is required for all other USD routes" 403
  }
}
