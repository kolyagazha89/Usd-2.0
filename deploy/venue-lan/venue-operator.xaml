<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USD — Офлайн-сервер" Width="930" Height="810" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F6F4F3" Foreground="#25242A"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#615D65"/>
    <SolidColorBrush x:Key="Accent" Color="#781D3F"/>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="18,15"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5DFE1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#4D2638"/>
      <Setter Property="Background" Value="#F9F4F6"/>
      <Setter Property="BorderBrush" Value="#E6D7DE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="MinHeight" Value="37"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B77A98"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Background" Value="#F1EFF0"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#E6E1E3"/>
                <Setter Property="Foreground" Value="#68636A"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </Window.Resources>
  <DockPanel x:Name="Dashboard">
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5DFE1" BorderThickness="0,0,0,1" Padding="22,12">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left" Background="{StaticResource Accent}" CornerRadius="7" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="USD" Foreground="White" FontWeight="Bold" FontSize="17"/>
        </Border>
        <Button x:Name="Account" DockPanel.Dock="Right" Content="Войти в USD" Margin="12,0,0,0"/>
        <TextBlock Text="Офлайн-сервер" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5DFE1" BorderThickness="0,1,0,0" Padding="20,8">
      <StackPanel>
        <TextBlock x:Name="Notice" Text="Проверяем локальный сервер…" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,0" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,4">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <Border x:Name="StatusBadge" DockPanel.Dock="Right" Background="#F4E8ED" CornerRadius="11" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Top" MaxWidth="225">
                <TextBlock x:Name="Status" Foreground="{StaticResource Accent}" Text="Проверяем сервер" FontSize="12" FontWeight="SemiBold"/>
              </Border>
              <TextBlock x:Name="StageTitle" FontSize="24" FontWeight="SemiBold" Text="Текущий этап"/>
            </DockPanel>
            <TextBlock x:Name="StageMeta" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="StageStats" Margin="0,6,0,0" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="StatusReason" Margin="0,4,0,0" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
            <Border BorderThickness="0,1,0,0" BorderBrush="#EEE8EB" Margin="0,13,0,0" Padding="0,11,0,0">
              <StackPanel>
                <TextBlock Text="Подготовка к соревнованиям" Style="{StaticResource Heading}"/>
                <Label Content="Этап для загрузки" Target="{Binding ElementName=Stages}" Padding="0,0,0,5" Foreground="{StaticResource Muted}"/>
                <DockPanel LastChildFill="True">
                  <Button x:Name="Load" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Загрузить этап" Margin="10,0,0,0"/>
                  <ComboBox x:Name="Stages" MinHeight="37" Padding="8,4" VerticalContentAlignment="Center" DisplayMemberPath="Label"
                            TextSearch.TextPath="Label" AutomationProperties.Name="Доступные этапы"/>
                </DockPanel>
                <TextBlock x:Name="StageHint" Margin="0,6,0,0" Style="{StaticResource Caption}"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="Install" Content="Установить или обновить сервер" Margin="0,0,8,6"/>
                  <Button x:Name="Directory" Content="Обновить участников и автомобили" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="Онлайн-регистрации входят в первую загрузку этапа. Обновление справочника добавляет профили и авто, сохраняя заявки, инспекции и результаты судей." Style="{StaticResource Caption}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Работа на площадке" Style="{StaticResource Heading}"/>
            <WrapPanel>
              <Button x:Name="Start" Style="{StaticResource Primary}" Content="Запустить офлайн-сервер" Margin="0,0,8,7"/>
              <Button x:Name="Admin" Content="Открыть локальную админку" Margin="0,0,8,7"/>
              <Button x:Name="Live" Content="Открыть LIVE-табло" Margin="0,0,8,7"/>
              <Button x:Name="Certificate" Content="Получить сертификат для судей" Margin="0,0,0,7"/>
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center" Margin="0,4,0,0">
              <TextBlock x:Name="Address" Text="Адрес появится после запуска" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Caption}"/>
              <Button x:Name="Copy" Content="Копировать адрес"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Завершение соревнований" Style="{StaticResource Heading}"/>
            <WrapPanel>
              <Button x:Name="Backup" Content="Сохранить резервную копию" Margin="0,0,8,6"/>
              <Button x:Name="Send" Style="{StaticResource Primary}" Content="Отправить результаты на сайт" Margin="0,0,8,6"/>
              <Button x:Name="Archive" Content="Архив этапов" Margin="0,0,0,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <WrapPanel Margin="0,0,0,10">
          <Button x:Name="Help" Content="Инструкция" Margin="0,0,8,0"/>
          <Button x:Name="Diagnostics" Content="Диагностика" Margin="0,0,8,0"/>
          <Button x:Name="Journal" Content="Журнал операций"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
