# Copy to .env outside version control; NEVER reuse production credentials.
# Reserve this exact IPv4 address for the laptop in the venue Wi-Fi router.
VENUE_BIND_IP=192.168.50.10
# One 40-character commit SHA whose API and frontend GHCR images were published.
VENUE_IMAGE_TAG=REPLACE_WITH_APPROVED_COMMIT_SHA
# The UUID of the ONE signed competition stage loaded onto this laptop.
VENUE_STAGE_ID=REPLACE_WITH_STAGE_UUID
# Authenticated SHA-256 of Ed25519 public-key SPKI in DER, received separately.
# openssl pkey -pubin -in signing-public.pem -outform DER | sha256sum
VENUE_SIGNING_KEY_FINGERPRINT=REPLACE_WITH_64_HEX_FINGERPRINT
VENUE_DB_NAME=usd_venue
VENUE_DB_USER=usd_venue
VENUE_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_VENUE_ONLY_PASSWORD
# URL encode any special characters in the database password.
VENUE_DATABASE_URL=postgresql://usd_venue:REPLACE_WITH_ENCODED_PASSWORD@db:5432/usd_venue?schema=public
VENUE_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_BYTES_OF_RANDOM_DATA
# Root storage keys are for local RustFS provisioning only.
VENUE_S3_ROOT_ACCESS=REPLACE_WITH_LOCAL_RUSTFS_ROOT_ACCESS_KEY
VENUE_S3_ROOT_SECRET=REPLACE_WITH_LOCAL_RUSTFS_ROOT_SECRET_KEY
# Separate restricted IAM/service account scoped to usd-venue-media.
VENUE_S3_APP_ACCESS=REPLACE_WITH_LIMITED_MEDIA_SERVICE_ACCESS
VENUE_S3_APP_SECRET=REPLACE_WITH_LIMITED_MEDIA_SERVICE_SECRET
