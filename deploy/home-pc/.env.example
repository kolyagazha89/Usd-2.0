# Never commit .env with real secrets.
APP_DOMAIN=app.usd-russia.ru
API_DOMAIN=api.usd-russia.ru
ACME_EMAIL=admin@usd-russia.ru
USD_IMAGE_TAG=REPLACE_WITH_SUCCESSFUL_GITHUB_ACTIONS_COMMIT_SHA

POSTGRES_DB=usd
POSTGRES_USER=usd_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql://usd_app:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/usd?schema=public

JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARS
JWT_ISSUER=usd-2.0-api
JWT_AUDIENCE=usd-2.0-client
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAME=usd_refresh_token

FRONTEND_URL=https://app.usd-russia.ru
API_PUBLIC_URL=https://api.usd-russia.ru
PUBLIC_API_URL=https://api.usd-russia.ru

S3_ENDPOINT=REPLACE_WITH_ACTUAL_S3_ENDPOINT
S3_REGION=auto
S3_BUCKET=REPLACE_WITH_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
# S3_FORCE_PATH_STYLE=true

# Choose one supported mail provider; e.g. Gmail API:
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=

# Keep the original key when migrating existing encrypted Google tokens:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://api.usd-russia.ru/google/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=
