[Unit]
Description=USD published main images and optional schema-pinned release
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
StateDirectory=usd-deployer
StateDirectoryMode=0700
Environment=BUILDX_CONFIG=/var/lib/usd-deployer/buildx
Environment=RCLONE_CONFIG=/var/lib/usd-deployer/rclone.conf
Environment=RCLONE_CACHE_DIR=/var/lib/usd-deployer/rclone-cache
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=-/home/usd/usd-deploy/deploy/home-pc
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateTmp=true
ExecStart=/usr/local/sbin/usd-auto-deploy
TimeoutStartSec=120min
TimeoutStopSec=10min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
